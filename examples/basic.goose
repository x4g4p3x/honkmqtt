import honkmqtt from "..";

fn main() {
    let status, size = honkmqtt::frame([0xc0, 0x00], 1024);
    assert(status == honkmqtt::OK && size == 2);
    assert(honkmqtt::matches("sensors/+/temp", "sensors/kitchen/temp"));
    var pub_out: u8[32] = [0; 32];
    let es, n = honkmqtt::encode_publish(false, 0, false, "sensors/kitchen/temp", 0, "22", pub_out);
    assert(es == honkmqtt::OK && n > 0);
    let ps, used, _, _, _, _ = honkmqtt::publish(pub_out[0..n], 64);
    assert(ps == honkmqtt::OK && used == n);
    var ack: u8[4] = [0; 4];
    let aks, akn = honkmqtt::encode_pubresp(honkmqtt::PUBACK, 1, ack);
    assert(aks == honkmqtt::OK && akn == 4);
    let rs, ru, rid = honkmqtt::pubresp(ack, honkmqtt::PUBACK);
    assert(rs == honkmqtt::OK && ru == 4 && rid == 1);
    var ca: u8[4] = [0; 4];
    let cs, cn = honkmqtt::encode_connack(false, 0, ca);
    assert(cs == honkmqtt::OK && cn == 4);
    let ks, ku, sp, rc = honkmqtt::connack(ca);
    assert(ks == honkmqtt::OK && ku == 4 && sp == false && rc == 0);
    var conn: u8[32] = [0; 32];
    let xs, xn = honkmqtt::encode_connect(
        true, 0, "demo", false, 0, false, "", "", false, "", false, "", conn);
    assert(xs == honkmqtt::OK && xn > 0);
    let ys, yu, yf, _, _, yl, _, _, _, _, _, _, _, _ = honkmqtt::connect(conn[0..xn], 64);
    assert(ys == honkmqtt::OK && yu == xn && (yf & 2) != 0 && yl == 4);
    var sub_out: u8[16] = [0; 16];
    let list: u8[4] = [0x00, 0x01, 0x61, 0x00];
    let ss, sn = honkmqtt::encode_subscribe(1, list, sub_out);
    assert(ss == honkmqtt::OK && sn == 8);
    let ps2, pu, pid, _, _ = honkmqtt::subscribe(sub_out[0..sn], 64);
    assert(ps2 == honkmqtt::OK && pu == sn && pid == 1);
    var sa: u8[8] = [0; 8];
    let codes: u8[1] = [0x00];
    let as_, an = honkmqtt::encode_suback(1, codes, sa);
    assert(as_ == honkmqtt::OK && an == 5);
    let ks2, ku2, kid, _, _ = honkmqtt::suback(sa[0..an], 64);
    assert(ks2 == honkmqtt::OK && ku2 == an && kid == 1);
    var unsub_out: u8[16] = [0; 16];
    let ulist: u8[3] = [0x00, 0x01, 0x61];
    let us, un = honkmqtt::encode_unsubscribe(1, ulist, unsub_out);
    assert(us == honkmqtt::OK && un == 7);
    let ups, upu, upid, _, _ = honkmqtt::unsubscribe(unsub_out[0..un], 64);
    assert(ups == honkmqtt::OK && upu == un && upid == 1);
    var ua: u8[4] = [0; 4];
    let uas, uan = honkmqtt::encode_unsuback(1, ua);
    assert(uas == honkmqtt::OK && uan == 4);
    let uaks, uaku, uakid = honkmqtt::unsuback(ua);
    assert(uaks == honkmqtt::OK && uaku == 4 && uakid == 1);
    print("PINGREQ frame: ", size, " bytes; PUBLISH encoded: ", n, " bytes; PUBACK id=", rid, "; CONNACK rc=", rc, "; CONNECT id_len=", yl, "; SUBSCRIBE id=", pid, "; UNSUBSCRIBE id=", upid);
}
